<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="tfg.selampr.hidrogestion.ui.fragments.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home" />

    <fragment

        android:id="@+id/historialFragment"
        android:name="tfg.selampr.hidrogestion.ui.fragments.HistorialFragment"
        android:label="Historial"
        tools:layout="@layout/fragment_historial">

        <action
            android:id="@+id/action_historialFragment_to_corteFragment"
            app:destination="@id/corteFragment" />
    </fragment>



    <fragment
        android:id="@+id/perfilFragment"
        android:name="tfg.selampr.hidrogestion.ui.fragments.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />

    <fragment
        android:id="@+id/corteFragment"
        android:name="tfg.selampr.hidrogestion.ui.fragments.CorteFragment"
        tools:layout="@layout/fragment_corte"
        android:label="Añadir Corte">
        <argument
          android:name="corteId"
          app:argType="integer"
          android:defaultValue="-1" />
    </fragment>


</navigation>
